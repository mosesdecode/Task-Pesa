{
  "env": {
    "DATABASE_URL": "file:./dev.db"
  },
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/api/paystack/webhook",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
